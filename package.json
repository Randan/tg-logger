{
  "name": "@randan/tg-logger",
  "version": "1.1.1",
  "description": "Shared NestJS logger and admin notification modules for Telegram bots",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prebuild": "rm -rf dist tsconfig.build.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "nestjs-telegraf": "^2.0.0",
    "telegraf": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "nestjs-telegraf": "^2.2.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "telegraf": "^4.16.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "nestjs",
    "telegram",
    "logger",
    "bot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randan/tg-logger.git"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "watchman": false,
    "coverageDirectory": "../coverage",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!index.ts",
      "!**/*.module.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 80,
        "functions": 90,
        "statements": 90
      }
    }
  }
}
